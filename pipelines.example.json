{
  "pollIntervalMinutes": 5,
  "fetchLimit": 50,
  "backfillHours": 24,
  "timeZone": "Asia/Kolkata",
  "stateFile": "/app/data/pipeline-state.json",
  "pipelines": [
    {
      "id": "receipts",
      "group": "Bill & Receipt",
      "media": {
        "dir": "/app/drops/receipts",
        "types": [
          "image/",
          "application/pdf"
        ],
        "includeTextOnly": true
      },
      "deleteAfterCapture": "me"
    },
    {
      "id": "reading",
      "group": "GP read",
      "sheet": {
        "name": "WhatsApp Messages"
      },
      "queue": {
        "dir": "/app/drops/reading",
        "onlyWithUrls": true
      },
      "results": {
        "file": "/app/drops/reading/results.jsonl"
      },
      "deleteAfterCapture": "me"
    },
    {
      "id": "ask",
      "group": "Ask Claude",
      "queue": {
        "dir": "/app/drops/ask"
      },
      "outbox": {
        "dir": "/app/drops/ask"
      },
      "deleteAfterCapture": false
    }
  ]
}
